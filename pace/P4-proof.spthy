          case Reveal_case_1
          by contradiction /* from formulas */
        next
          case Reveal_case_2
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
next
  case B_4_send
  solve( St_B_4( $R, ~id, $I, ~kAB, x, s, ~y, x.1 ) ▶₀ #i )
    case B_3_receive_case_1
    solve( !KU( KDF(s, x, ~y) ) @ #vk )
