lemma secrecy:
  all-traces
  "∀ A B x #i.
    ((Secret( A, B, x ) @ #i) ∧
     (¬((∃ #r. Reveal( A ) @ #r) ∨ (∃ #r. Reveal( B ) @ #r)))) ⇒
    (¬(∃ #j. K( x ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ A B x #i.
  (Secret( A, B, x ) @ #i)
 ∧
  (∀ #r. (Reveal( A ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( B ) @ #r) ⇒ ⊥) ∧
  (∃ #j. (K( x ) @ #j))"
*/
simplify
solve( Secret( A, B, x ) @ #i )
  case A_4_receive
  solve( St_A_4( $I, ~id, $R, ~kAB, ~x, ~s, y, x.1 ) ▶₀ #i )
    case A_3_send_case_1
    solve( !KU( KDF(~s, ~x, y) ) @ #vk )
      case c_KDF
      solve( !KU( ~s ) @ #vk.3 )
        case A_1_send
        solve( !KU( ~kAB ) @ #vk.6 )
          case Reveal_case_1
          by contradiction /* from formulas */
        next
          case Reveal_case_2
          by contradiction /* from formulas */
        qed
      qed
    qed
  next
    case A_3_send_case_2
    solve( !KU( KDF(~s, ~x, y) ) @ #vk )
      case c_KDF
      solve( !KU( ~s ) @ #vk.3 )
