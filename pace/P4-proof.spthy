theory P4 begin

// Function signature and definition of the equational theory E

functions: KDF/3, fst/1, h/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2









rule (modulo E) ShareKey:
   [ Fr( ~kAB ) ]
  --[ ShareKey( $A, $B, ~kAB ) ]->
   [ !SharedKey( $A, $B, ~kAB ), !SharedKey( $B, $A, ~kAB ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal:
   [ !SharedKey( $A, $B, ~kAB ) ] --[ Reveal( $A ) ]-> [ Out( ~kAB ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Init_A:
   [ !SharedKey( $I, $R, ~kAB ), Fr( ~id ) ]
  --[ Create_A( $I, ~id ) ]->
   [ St_A_1( $I, ~id, $R, ~kAB ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Init_B:
   [ !SharedKey( $R, $I, ~kAB ), Fr( ~id ) ]
  --[ Create_B( $R, ~id ) ]->
   [ St_B_1( $R, ~id, $I, ~kAB ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) A_1_send:
   [ St_A_1( $I, ~id, $R, ~kAB ), Fr( ~x ), Fr( ~s ) ]
  --[ Send( $I, ~x ) ]->
   [
   St_A_2( $I, ~id, $R, ~kAB, ~x, ~s ), Out( <~x, senc(~s, h(~kAB))> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_1_receive:
   [ St_B_1( $R, ~id, $I, ~kAB ), In( <x, senc(s, h(~kAB))> ) ]
  --[ Receive( $R, x ) ]->
   [ St_B_2( $R, ~id, $I, ~kAB, x, s ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_2_send:
   [ St_B_2( $R, ~id, $I, ~kAB, x, s ), Fr( ~y ) ]
  --[
  Send( $R, ~y ), Running( $R, $I, <'I', 'R', x, ~y, KDF(s, x, ~y)> )
  ]->
   [ St_B_3( $R, ~id, $I, ~kAB, x, s, ~y, KDF(s, x, ~y) ), Out( ~y ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) A_2_receive:
   [ St_A_2( $I, ~id, $R, ~kAB, ~x, ~s ), In( y ) ]
  --[ Receive( $I, y ) ]->
   [ St_A_3( $I, ~id, $R, ~kAB, ~x, ~s, y, KDF(~s, ~x, y) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) A_3_send:
   [ St_A_3( $I, ~id, $R, ~kAB, ~x, ~s, y, kdf ) ]
  --[ Send( $I, y ), Running( $I, $R, <'R', 'I', ~x, y, kdf> ) ]->
   [
   St_A_4( $I, ~id, $R, ~kAB, ~x, ~s, y, kdf ),
   Out( senc(<'I', $I, y>, kdf) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_3_receive:
   [
   St_B_3( $R, ~id, $I, ~kAB, x, s, ~y, kdf ),
   In( senc(<'I', $I, ~y>, kdf) )
   ]
  --[ Receive( $R, ~y ), Commit( $R, $I, <'R', 'I', x, ~y, kdf> ) ]->
   [ St_B_4( $R, ~id, $I, ~kAB, x, s, ~y, kdf ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_4_send:
   [ St_B_4( $R, ~id, $I, ~kAB, x, s, ~y, kdf ) ]
  --[
  Send( $R, x ), Secret( $R, $I, kdf ),
  FinishedB( $R, $I, <x, ~y, kdf> )
  ]->
   [
   St_B_5( $R, ~id, $I, ~kAB, x, s, ~y, kdf ),
   Out( senc(<'R', $R, x>, kdf) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) A_4_receive:
   [
   St_A_4( $I, ~id, $R, ~kAB, ~x, ~s, y, kdf ),
   In( senc(<'R', $R, ~x>, kdf) )
   ]
  --[
  Receive( $I, ~x ), Commit( $I, $R, <'I', 'R', ~x, y, kdf> ),
  Secret( $I, $R, kdf ), FinishedA( $I, $R, <~x, y, kdf> )
  ]->
   [ St_A_5( $I, ~id, $R, ~kAB, ~x, ~s, y, kdf ) ]

  /* has exactly the trivial AC variant */

lemma executable:
  exists-trace
  "∃ #i #j A B m.
    ((((FinishedA( A, B, m ) @ #i) ∧ (FinishedB( B, A, m ) @ #j)) ∧
      (¬(A = B))) ∧
     (¬(∃ #k. Reveal( A ) @ #k))) ∧
    (¬(∃ #k. Reveal( B ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j A B m.
  (FinishedA( A, B, m ) @ #i) ∧ (FinishedB( B, A, m ) @ #j)
 ∧
  (¬(A = B)) ∧
  (∀ #k. (Reveal( A ) @ #k) ⇒ ⊥) ∧
  (∀ #k. (Reveal( B ) @ #k) ⇒ ⊥)"
*/
simplify
solve( St_A_4( $I, ~id, $R, ~kAB, ~x, ~s, ~y, kdf ) ▶₀ #i )
  case A_3_send_case_1
  solve( St_B_4( $R, ~id.1, $I, ~kAB.1, ~x, s.1, ~y, KDF(~s, ~x, ~y)
         ) ▶₀ #j )
    case B_3_receive_case_2
    solve( !KU( senc(~s, h(~kAB.1)) ) @ #vk.5 )
      case A_1_send
      solve( !KU( ~y ) @ #vk.2 )
        case B_2_send
        solve( !KU( ~x ) @ #vk.5 )
          case A_1_send
          solve( !KU( senc(<'R', $R, ~x>, KDF(~s, ~x, ~y)) ) @ #vk.4 )
            case B_4_send
            solve( !KU( senc(<'I', $I, ~y>, KDF(~s, ~x, ~y)) ) @ #vk.5 )
              case A_3_send
              SOLVED // trace found
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma injectiveagreementINITIATOR:
  all-traces
  "∀ a b t #i.
    ((Commit( a, b, <'I', 'R', t> ) @ #i) ∧
     (¬((∃ #r. Reveal( a ) @ #r) ∨ (∃ #r. Reveal( b ) @ #r)))) ⇒
    (∃ #j.
      (Running( b, a, <'I', 'R', t> ) @ #j) ∧
      (¬(∃ a2 b2 #i2.
          (Commit( a2, b2, <'I', 'R', t> ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ a b t #i.
  (Commit( a, b, <'I', 'R', t> ) @ #i)
 ∧
  (∀ #r. (Reveal( a ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( b ) @ #r) ⇒ ⊥) ∧
  (∀ #j.
    (Running( b, a, <'I', 'R', t> ) @ #j)
   ⇒
    ∃ a2 b2 #i2.
     (Commit( a2, b2, <'I', 'R', t> ) @ #i2) ∧ ¬(#i2 = #i))"
*/
simplify
solve( Commit( a, b, <'I', 'R', t> ) @ #i )
  case A_4_receive
  solve( St_A_4( $I, ~id, $R, ~kAB, ~x, ~s, y, kdf ) ▶₀ #i )
    case A_3_send_case_1
    solve( !KU( senc(<'R', $R, ~x>, KDF(~s, ~x, y)) ) @ #vk )
      case B_4_send_case_1
      solve( !KU( senc(<'I', $I.1, ~y>, KDF(~s, ~x, ~y)) ) @ #vk.2 )
        case A_3_send
        solve( (#i2 < #i)  ∥ (#i < #i2) )
          case case_1
          solve( Commit( a2, b2, <'I', 'R', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case A_4_receive
            solve( St_A_4( $I.1, ~id.1, $R.1, ~kAB.1, ~x, ~s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case A_3_send
              by contradiction /* cyclic */
            qed
          qed
        next
          case case_2
          solve( Commit( a2, b2, <'I', 'R', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case A_4_receive
            solve( St_A_4( $I.1, ~id.1, $R.1, ~kAB.1, ~x, ~s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case A_3_send
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case c_senc
        solve( !KU( KDF(~s, ~x, ~y) ) @ #vk.8 )
          case c_KDF
          solve( !KU( ~s ) @ #vk.11 )
            case A_1_send
            solve( !KU( ~kAB ) @ #vk.13 )
              case Reveal_case_1
              by contradiction /* from formulas */
            next
              case Reveal_case_2
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case B_4_send_case_2
      solve( !KU( senc(<'I', $I.1, ~y>, KDF(~s, ~x, ~y)) ) @ #vk.2 )
        case A_3_send
        solve( (#i2 < #i)  ∥ (#i < #i2) )
          case case_1
          solve( Commit( a2, b2, <'I', 'R', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case A_4_receive
            solve( St_A_4( $I.1, ~id.1, $R.1, ~kAB.1, ~x, ~s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case A_3_send
              by contradiction /* cyclic */
            qed
          qed
        next
          case case_2
          solve( Commit( a2, b2, <'I', 'R', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case A_4_receive
            solve( St_A_4( $I.1, ~id.1, $R.1, ~kAB.1, ~x, ~s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case A_3_send
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case c_senc
        solve( !KU( KDF(~s, ~x, ~y) ) @ #vk.8 )
          case c_KDF
          solve( !KU( ~s ) @ #vk.11 )
            case A_1_send
            solve( !KU( ~kAB ) @ #vk.13 )
              case Reveal_case_1
              by contradiction /* from formulas */
            next
              case Reveal_case_2
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case c_senc
      solve( !KU( KDF(~s, ~x, y) ) @ #vk.3 )
        case c_KDF
        solve( !KU( ~s ) @ #vk.8 )
          case A_1_send
          solve( !KU( ~kAB ) @ #vk.10 )
            case Reveal_case_1
            by contradiction /* from formulas */
          next
            case Reveal_case_2
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  next
    case A_3_send_case_2
    solve( !KU( senc(<'R', $R, ~x>, KDF(~s, ~x, y)) ) @ #vk )
      case B_4_send_case_1
      solve( !KU( senc(<'I', $I.1, ~y>, KDF(~s, ~x, ~y)) ) @ #vk.2 )
        case A_3_send
        solve( (#i2 < #i)  ∥ (#i < #i2) )
          case case_1
          solve( Commit( a2, b2, <'I', 'R', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case A_4_receive
            solve( St_A_4( $I.1, ~id.1, $R.1, ~kAB.1, ~x, ~s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case A_3_send
              by contradiction /* cyclic */
            qed
          qed
        next
          case case_2
          solve( Commit( a2, b2, <'I', 'R', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case A_4_receive
            solve( St_A_4( $I.1, ~id.1, $R.1, ~kAB.1, ~x, ~s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case A_3_send
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case c_senc
        solve( !KU( KDF(~s, ~x, ~y) ) @ #vk.8 )
          case c_KDF
          solve( !KU( ~s ) @ #vk.11 )
            case A_1_send
            solve( !KU( ~kAB ) @ #vk.13 )
              case Reveal_case_1
              by contradiction /* from formulas */
            next
              case Reveal_case_2
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case B_4_send_case_2
      solve( !KU( senc(<'I', $I.1, ~y>, KDF(~s, ~x, ~y)) ) @ #vk.2 )
        case A_3_send
        solve( (#i2 < #i)  ∥ (#i < #i2) )
          case case_1
          solve( Commit( a2, b2, <'I', 'R', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case A_4_receive
            solve( St_A_4( $I.1, ~id.1, $R.1, ~kAB.1, ~x, ~s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case A_3_send
              by contradiction /* cyclic */
            qed
          qed
        next
          case case_2
          solve( Commit( a2, b2, <'I', 'R', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case A_4_receive
            solve( St_A_4( $I.1, ~id.1, $R.1, ~kAB.1, ~x, ~s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case A_3_send
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case c_senc
        solve( !KU( KDF(~s, ~x, ~y) ) @ #vk.8 )
          case c_KDF
          solve( !KU( ~s ) @ #vk.11 )
            case A_1_send
            solve( !KU( ~kAB ) @ #vk.13 )
              case Reveal_case_1
              by contradiction /* from formulas */
            next
              case Reveal_case_2
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case c_senc
      solve( !KU( KDF(~s, ~x, y) ) @ #vk.3 )
        case c_KDF
        solve( !KU( ~s ) @ #vk.8 )
          case A_1_send
          solve( !KU( ~kAB ) @ #vk.10 )
            case Reveal_case_1
            by contradiction /* from formulas */
          next
            case Reveal_case_2
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
qed

lemma injectiveagreementRESPONDER:
  all-traces
  "∀ a b t #i.
    ((Commit( a, b, <'R', 'I', t> ) @ #i) ∧
     (¬((∃ #r. Reveal( a ) @ #r) ∨ (∃ #r. Reveal( b ) @ #r)))) ⇒
    (∃ #j.
      (Running( b, a, <'R', 'I', t> ) @ #j) ∧
      (¬(∃ a2 b2 #i2.
          (Commit( a2, b2, <'R', 'I', t> ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ a b t #i.
  (Commit( a, b, <'R', 'I', t> ) @ #i)
 ∧
  (∀ #r. (Reveal( a ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( b ) @ #r) ⇒ ⊥) ∧
  (∀ #j.
    (Running( b, a, <'R', 'I', t> ) @ #j)
   ⇒
    ∃ a2 b2 #i2.
     (Commit( a2, b2, <'R', 'I', t> ) @ #i2) ∧ ¬(#i2 = #i))"
*/
simplify
solve( Commit( a, b, <'R', 'I', t> ) @ #i )
  case B_3_receive
  solve( St_B_3( $R, ~id, $I, ~kAB, x, s, ~y, kdf ) ▶₀ #i )
    case B_2_send_case_1
    solve( !KU( senc(<'I', $I, ~y>, KDF(s, x, ~y)) ) @ #vk )
      case A_3_send_case_1
      solve( !KU( senc(~s, h(~kAB)) ) @ #vk.3 )
        case A_1_send
        solve( (#i2 < #i)  ∥ (#i < #i2) )
          case case_1
          solve( Commit( a2, b2, <'R', 'I', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case B_3_receive
            solve( St_B_3( $R, ~id.1, $I.1, ~kAB.1, ~x, s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case B_2_send
              by contradiction /* cyclic */
            qed
          qed
        next
          case case_2
          solve( Commit( a2, b2, <'R', 'I', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case B_3_receive
            solve( St_B_3( $R, ~id.1, $I.1, ~kAB.1, ~x, s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case B_2_send
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case c_senc
        solve( !KU( ~s ) @ #vk.5 )
          case A_1_send
          solve( !KU( ~kAB.1 ) @ #vk.8 )
            case Reveal_case_1
            by contradiction /* from formulas */
          next
            case Reveal_case_2
            solve( !KU( h(~kAB) ) @ #vk.8 )
              case c_h
              solve( !KU( ~kAB ) @ #vk.9 )
                case Reveal_case_1
                by contradiction /* from formulas */
              next
                case Reveal_case_2
                by contradiction /* from formulas */
              qed
            qed
          qed
        qed
      qed
    next
      case A_3_send_case_2
      solve( !KU( senc(~s, h(~kAB)) ) @ #vk.3 )
        case A_1_send
        solve( (#i2 < #i)  ∥ (#i < #i2) )
          case case_1
          solve( Commit( a2, b2, <'R', 'I', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case B_3_receive
            solve( St_B_3( $R.1, ~id.1, $I.1, ~kAB.1, ~x, s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case B_2_send
              by contradiction /* cyclic */
            qed
          qed
        next
          case case_2
          solve( Commit( a2, b2, <'R', 'I', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case B_3_receive
            solve( St_B_3( $R.1, ~id.1, $I.1, ~kAB.1, ~x, s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case B_2_send
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case c_senc
        solve( !KU( ~s ) @ #vk.5 )
          case A_1_send
          solve( !KU( ~kAB.1 ) @ #vk.8 )
            case Reveal_case_1
            solve( !KU( h(~kAB) ) @ #vk.8 )
              case c_h
              solve( !KU( ~kAB ) @ #vk.9 )
                case Reveal_case_1
                by contradiction /* from formulas */
              next
                case Reveal_case_2
                by contradiction /* from formulas */
              qed
            qed
          next
            case Reveal_case_2
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case c_senc
      solve( !KU( KDF(s, x, ~y) ) @ #vk.5 )
        case c_KDF
        solve( !KU( senc(s, h(~kAB)) ) @ #vk.4 )
          case A_1_send_case_1
          solve( !KU( ~s ) @ #vk.10 )
            case A_1_send
            solve( !KU( ~kAB ) @ #vk.12 )
              case Reveal_case_1
              by contradiction /* from formulas */
            next
              case Reveal_case_2
              by contradiction /* from formulas */
            qed
          qed
        next
          case A_1_send_case_2
          solve( !KU( ~s ) @ #vk.10 )
            case A_1_send
            solve( !KU( ~kAB ) @ #vk.12 )
              case Reveal_case_1
              by contradiction /* from formulas */
            next
              case Reveal_case_2
              by contradiction /* from formulas */
            qed
          qed
        next
          case c_senc
          solve( !KU( h(~kAB) ) @ #vk.11 )
            case c_h
            solve( !KU( ~kAB ) @ #vk.12 )
              case Reveal_case_1
              by contradiction /* from formulas */
            next
              case Reveal_case_2
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    qed
  next
    case B_2_send_case_2
    solve( !KU( senc(<'I', $I, ~y>, KDF(s, x, ~y)) ) @ #vk )
      case A_3_send_case_1
      solve( !KU( senc(~s, h(~kAB)) ) @ #vk.3 )
        case A_1_send
        solve( (#i2 < #i)  ∥ (#i < #i2) )
          case case_1
          solve( Commit( a2, b2, <'R', 'I', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case B_3_receive
            solve( St_B_3( $R.1, ~id.1, $I.1, ~kAB.1, ~x, s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case B_2_send
              by contradiction /* cyclic */
            qed
          qed
        next
          case case_2
          solve( Commit( a2, b2, <'R', 'I', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case B_3_receive
            solve( St_B_3( $R.1, ~id.1, $I.1, ~kAB.1, ~x, s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case B_2_send
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case c_senc
        solve( !KU( ~s ) @ #vk.5 )
          case A_1_send
          solve( !KU( ~kAB.1 ) @ #vk.8 )
            case Reveal_case_1
            by contradiction /* from formulas */
          next
            case Reveal_case_2
            solve( !KU( h(~kAB) ) @ #vk.8 )
              case c_h
              solve( !KU( ~kAB ) @ #vk.9 )
                case Reveal_case_1
                by contradiction /* from formulas */
              next
                case Reveal_case_2
                by contradiction /* from formulas */
              qed
            qed
          qed
        qed
      qed
    next
      case A_3_send_case_2
      solve( !KU( senc(~s, h(~kAB)) ) @ #vk.3 )
        case A_1_send
        solve( (#i2 < #i)  ∥ (#i < #i2) )
          case case_1
          solve( Commit( a2, b2, <'R', 'I', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case B_3_receive
            solve( St_B_3( $R, ~id.1, $I.1, ~kAB.1, ~x, s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case B_2_send
              by contradiction /* cyclic */
            qed
          qed
        next
          case case_2
          solve( Commit( a2, b2, <'R', 'I', ~x, ~y, KDF(~s, ~x, ~y)>
                 ) @ #i2 )
            case B_3_receive
            solve( St_B_3( $R, ~id.1, $I.1, ~kAB.1, ~x, s.1, ~y,
                           KDF(~s, ~x, ~y)
                   ) ▶₀ #i2 )
              case B_2_send
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case c_senc
        solve( !KU( ~s ) @ #vk.5 )
          case A_1_send
          solve( !KU( ~kAB.1 ) @ #vk.8 )
            case Reveal_case_1
            solve( !KU( h(~kAB) ) @ #vk.8 )
              case c_h
              solve( !KU( ~kAB ) @ #vk.9 )
                case Reveal_case_1
                by contradiction /* from formulas */
              next
                case Reveal_case_2
                by contradiction /* from formulas */
              qed
            qed
          next
            case Reveal_case_2
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case c_senc
      solve( !KU( KDF(s, x, ~y) ) @ #vk.5 )
        case c_KDF
        solve( !KU( senc(s, h(~kAB)) ) @ #vk.4 )
          case A_1_send_case_1
          solve( !KU( ~s ) @ #vk.10 )
            case A_1_send
            solve( !KU( ~kAB ) @ #vk.12 )
              case Reveal_case_1
              by contradiction /* from formulas */
            next
              case Reveal_case_2
              by contradiction /* from formulas */
            qed
          qed
        next
          case A_1_send_case_2
          solve( !KU( ~s ) @ #vk.10 )
            case A_1_send
            solve( !KU( ~kAB ) @ #vk.12 )
              case Reveal_case_1
              by contradiction /* from formulas */
            next
              case Reveal_case_2
              by contradiction /* from formulas */
            qed
          qed
        next
          case c_senc
          solve( !KU( h(~kAB) ) @ #vk.11 )
            case c_h
            solve( !KU( ~kAB ) @ #vk.12 )
              case Reveal_case_1
              by contradiction /* from formulas */
            next
              case Reveal_case_2
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma noninjectiveagreementINITIATOR:
  all-traces
  "∀ a b t #i.
    ((Commit( a, b, <'I', 'R', t> ) @ #i) ∧
     (¬((∃ #r. Reveal( a ) @ #r) ∨ (∃ #r. Reveal( b ) @ #r)))) ⇒
    (∃ #j. Running( b, a, <'I', 'R', t> ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ a b t #i.
  (Commit( a, b, <'I', 'R', t> ) @ #i)
 ∧
  (∀ #r. (Reveal( a ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( b ) @ #r) ⇒ ⊥) ∧
  (∀ #j. (Running( b, a, <'I', 'R', t> ) @ #j) ⇒ ⊥)"
*/
simplify
solve( Commit( a, b, <'I', 'R', t> ) @ #i )
  case A_4_receive
  solve( St_A_4( $I, ~id, $R, ~kAB, ~x, ~s, y, kdf ) ▶₀ #i )
    case A_3_send_case_1
    solve( !KU( senc(<'R', $R, ~x>, KDF(~s, ~x, y)) ) @ #vk )
      case B_4_send_case_1
      solve( !KU( senc(<'I', $I.1, ~y>, KDF(~s, ~x, ~y)) ) @ #vk.2 )
        case A_3_send
        by contradiction /* from formulas */
      next
        case c_senc
        solve( !KU( KDF(~s, ~x, ~y) ) @ #vk.8 )
          case c_KDF
          solve( !KU( ~s ) @ #vk.11 )
            case A_1_send
            solve( !KU( ~kAB ) @ #vk.13 )
              case Reveal_case_1
              by contradiction /* from formulas */
            next
              case Reveal_case_2
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case B_4_send_case_2
      solve( !KU( senc(<'I', $I.1, ~y>, KDF(~s, ~x, ~y)) ) @ #vk.2 )
        case A_3_send
        by contradiction /* from formulas */
      next
        case c_senc
        solve( !KU( KDF(~s, ~x, ~y) ) @ #vk.8 )
          case c_KDF
          solve( !KU( ~s ) @ #vk.11 )
            case A_1_send
            solve( !KU( ~kAB ) @ #vk.13 )
              case Reveal_case_1
              by contradiction /* from formulas */
            next
              case Reveal_case_2
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case c_senc
      solve( !KU( KDF(~s, ~x, y) ) @ #vk.3 )
        case c_KDF
        solve( !KU( ~s ) @ #vk.8 )
          case A_1_send
          solve( !KU( ~kAB ) @ #vk.10 )
            case Reveal_case_1
            by contradiction /* from formulas */
          next
            case Reveal_case_2
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  next
    case A_3_send_case_2
    solve( !KU( senc(<'R', $R, ~x>, KDF(~s, ~x, y)) ) @ #vk )
      case B_4_send_case_1
      solve( !KU( senc(<'I', $I.1, ~y>, KDF(~s, ~x, ~y)) ) @ #vk.2 )
        case A_3_send
        by contradiction /* from formulas */
      next
        case c_senc
        solve( !KU( KDF(~s, ~x, ~y) ) @ #vk.8 )
          case c_KDF
          solve( !KU( ~s ) @ #vk.11 )
            case A_1_send
            solve( !KU( ~kAB ) @ #vk.13 )
              case Reveal_case_1
              by contradiction /* from formulas */
            next
              case Reveal_case_2
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case B_4_send_case_2
      solve( !KU( senc(<'I', $I.1, ~y>, KDF(~s, ~x, ~y)) ) @ #vk.2 )
        case A_3_send
        by contradiction /* from formulas */
      next
        case c_senc
        solve( !KU( KDF(~s, ~x, ~y) ) @ #vk.8 )
          case c_KDF
          solve( !KU( ~s ) @ #vk.11 )
            case A_1_send
            solve( !KU( ~kAB ) @ #vk.13 )
              case Reveal_case_1
              by contradiction /* from formulas */
            next
              case Reveal_case_2
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case c_senc
      solve( !KU( KDF(~s, ~x, y) ) @ #vk.3 )
        case c_KDF
        solve( !KU( ~s ) @ #vk.8 )
          case A_1_send
          solve( !KU( ~kAB ) @ #vk.10 )
            case Reveal_case_1
            by contradiction /* from formulas */
          next
