lemma secrecy:
  all-traces
  "∀ A B x #i.
    ((Secret( A, B, x ) @ #i) ∧
     (¬((∃ #r. Reveal( A ) @ #r) ∨ (∃ #r. Reveal( B ) @ #r)))) ⇒
    (¬(∃ #j. K( x ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ A B x #i.
  (Secret( A, B, x ) @ #i)
 ∧
  (∀ #r. (Reveal( A ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( B ) @ #r) ⇒ ⊥) ∧
  (∃ #j. (K( x ) @ #j))"
*/
simplify
solve( Secret( A, B, x ) @ #i )
  case A_4_receive
  solve( St_A_4( $I, ~id, $R, ~sharedKeyAB, ~s, $p, ~x, Y, x.1
         ) ▶₀ #i )
    case A_3_send_case_1
    solve( !KU( senc(<'R', $R, map(~s, $p)^~x>, h(z)) ) @ #vk.1 )
      case B_4_send_case_1
      solve( !KU( h(map(~s, $p)^(~x*~y)) ) @ #vk.1 )
        case c_h
        solve( !KU( map(~s, $p)^(~x*~y) ) @ #vk.7 )
          case A_1_send_case_1
          by solve( !KU( ~y ) @ #vk.8 )
        next
          case A_1_send_case_2
          by solve( !KU( ~x ) @ #vk.11 )
        next
          case B_2_send_case_1
          by solve( !KU( ~x ) @ #vk.8 )
        next
          case B_2_send_case_2
          by solve( !KU( ~y.1 ) @ #vk.11 )
        next
          case B_2_send_case_3
          by solve( !KU( ~y.1 ) @ #vk.11 )
        next
          case c_exp
          by solve( !KU( ~x ) @ #vk.10 )
        qed
      qed
    next
      case B_4_send_case_2
      solve( !KU( h(map(~s, $p)^(~x*~y)) ) @ #vk.1 )
        case c_h
        solve( !KU( map(~s, $p)^(~x*~y) ) @ #vk.7 )
          case A_1_send_case_1
          by solve( !KU( ~y ) @ #vk.8 )
        next
          case A_1_send_case_2
          by solve( !KU( ~x ) @ #vk.11 )
        next
          case B_2_send_case_1
          by solve( !KU( ~x ) @ #vk.8 )
        next
          case B_2_send_case_2
          by solve( !KU( ~y.1 ) @ #vk.11 )
        next
          case B_2_send_case_3
          by solve( !KU( ~y.1 ) @ #vk.11 )
        next
          case c_exp
          by solve( !KU( ~x ) @ #vk.10 )
        qed
      qed
    next
      case c_senc
      solve( splitEqs(1) )
        case split_case_1
        solve( !KU( h(Y^~x) ) @ #vk.1 )
          case c_h
          solve( !KU( Y^~x ) @ #vk.8 )
            case A_1_send_case_1
            solve( !KU( map(~s, $p) ) @ #vk.3 )
              case A_1_send
              by solve( !KU( ~x ) @ #vk.9 )
            next
              case B_2_send_case_1
              by solve( !KU( ~y ) @ #vk.9 )
            next
              case B_2_send_case_2
              by solve( !KU( ~y ) @ #vk.9 )
            next
              case c_map
              solve( !KU( ~s ) @ #vk.8 )
                case A_1_send
                solve( !KU( ~sharedKeyAB ) @ #vk.11 )
                  case Reveal_case_1
                  by contradiction /* from formulas */
                next
                  case Reveal_case_2
                  by contradiction /* from formulas */
                qed
              qed
            qed
          next
            case A_1_send_case_2
            by solve( !KU( ~x ) @ #vk.10 )
          next
            case A_1_send_case_3
            by solve( !KU( ~x ) @ #vk.10 )
          next
            case B_2_send_case_1
            by solve( !KU( ~x ) @ #vk.10 )
          next
            case B_2_send_case_2
            by solve( !KU( ~x ) @ #vk.10 )
          next
            case c_exp
            by solve( !KU( ~x ) @ #vk.9 )
          qed
        qed
      next
        case split_case_2
        solve( !KU( z^inv(~x) ) @ #vk.2 )
          case A_1_send_case_1
          by solve( !KU( ~x.1 ) @ #vk.10 )
        next
          case A_1_send_case_2
          by solve( !KU( ~x.1 ) @ #vk.10 )
        next
          case A_1_send_case_3
