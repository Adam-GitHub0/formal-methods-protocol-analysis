lemma injectiveagreementRESPONDER:
  all-traces
  "∀ a b t #i.
    ((Commit( a, b, <'R', 'I', t> ) @ #i) ∧
     (¬((∃ #r. Reveal( a ) @ #r) ∨ (∃ #r. Reveal( b ) @ #r)))) ⇒
    (∃ #j.
      (Running( b, a, <'R', 'I', t> ) @ #j) ∧
      (¬(∃ a2 b2 #i2.
          (Commit( a2, b2, <'R', 'I', t> ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ a b t #i.
  (Commit( a, b, <'R', 'I', t> ) @ #i)
 ∧
  (∀ #r. (Reveal( a ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( b ) @ #r) ⇒ ⊥) ∧
  (∀ #j.
    (Running( b, a, <'R', 'I', t> ) @ #j)
   ⇒
    ∃ a2 b2 #i2.
     (Commit( a2, b2, <'R', 'I', t> ) @ #i2) ∧ ¬(#i2 = #i))"
*/
simplify
solve( Commit( a, b, <'R', 'I', t> ) @ #i )
  case B_3_receive
  solve( St_B_3( $R, ~id, $I, ~sharedKeyAB, s, $p, X, ~y, Kab
         ) ▶₀ #i )
    case B_2_send_case_1
    solve( !KU( senc(<'I', $I, map(s, $p)^~y>, h(z)) ) @ #vk )
      case A_3_send_case_1
      solve( !KU( senc(s, h(~sharedKeyAB)) ) @ #vk.3 )
        case A_1_send_case_1
        solve( !KU( map(~s, $p)^~x ) @ #vk.3 )
          case A_1_send_case_1
          solve( (#i2 < #i)  ∥ (#i < #i2) )
            case case_1
            solve( Commit( a2, b2,
                           <'R', 'I', map(~s, $p)^~x, map(~s, $p)^~y, h(map(~s, $p)^(~x*~y))>
                   ) @ #i2 )
              case B_3_receive
              solve( St_B_3( $R, ~id.1, $I.1, ~sharedKeyAB.1, ~s, $p,
                             map(~s, $p)^~x, ~y, h(map(~s, $p)^(~x*~y))
                     ) ▶₀ #i2 )
                case B_2_send
                by contradiction /* cyclic */
              qed
            qed
          next
            case case_2
            solve( Commit( a2, b2,
                           <'R', 'I', map(~s, $p)^~x, map(~s, $p)^~y, h(map(~s, $p)^(~x*~y))>
                   ) @ #i2 )
              case B_3_receive
              solve( St_B_3( $R, ~id.1, $I.1, ~sharedKeyAB.1, ~s, $p,
                             map(~s, $p)^~x, ~y, h(map(~s, $p)^(~x*~y))
                     ) ▶₀ #i2 )
                case B_2_send
                by contradiction /* cyclic */
              qed
            qed
          qed
        next
          case A_1_send_case_2
          by solve( !KU( ~x ) @ #vk.6 )
        next
          case B_2_send_case_1
          by solve( !KU( ~x ) @ #vk.6 )
        next
          case B_2_send_case_2
          by solve( !KU( ~x ) @ #vk.6 )
        next
          case c_exp
          by solve( !KU( ~x ) @ #vk.6 )
        qed
      next
        case A_1_send_case_2
        solve( !KU( map(~s, $p)^~x ) @ #vk.3 )
          case A_1_send
          by solve( !KU( ~x ) @ #vk.6 )
        next
          case B_2_send_case_1
          by solve( !KU( ~x ) @ #vk.6 )
        next
          case B_2_send_case_2
          by solve( !KU( ~x ) @ #vk.6 )
        next
          case c_exp
          by solve( !KU( ~x ) @ #vk.6 )
        qed
      next
        case A_3_send_case_1
        solve( !KU( map(<'I', $I.1, ~sharedKeyAB^inv(~x)>, $p)^~x.1
               ) @ #vk.3 )
          case B_2_send_case_1
          by solve( !KU( ~x.1 ) @ #vk.7 )
        next
          case B_2_send_case_2
          by solve( !KU( ~x.1 ) @ #vk.7 )
        next
          case c_exp
          by solve( !KU( ~x.1 ) @ #vk.7 )
        qed
      next
        case A_3_send_case_2
        solve( !KU( map(<'I', $I.1, ~sharedKeyAB^inv(~x)>, $p)^~x.1
               ) @ #vk.3 )
          case B_2_send_case_1
          by solve( !KU( ~x.1 ) @ #vk.7 )
        next
          case B_2_send_case_2
          by solve( !KU( ~x.1 ) @ #vk.7 )
        next
          case c_exp
          by solve( !KU( ~x.1 ) @ #vk.7 )
        qed
      next
        case B_4_send_case_1
        solve( !KU( map(<'R', $R.1, ~sharedKeyAB^inv(~y)>, $p)^~x
               ) @ #vk.3 )
          case B_2_send_case_1
          by solve( !KU( ~x ) @ #vk.10 )
        next
          case B_2_send_case_2
          by solve( !KU( ~x ) @ #vk.10 )
        next
          case c_exp
          by solve( !KU( ~x ) @ #vk.10 )
        qed
      next
        case B_4_send_case_2
        solve( !KU( map(<'R', $R.1, ~sharedKeyAB^inv(~y)>, $p)^~x
               ) @ #vk.3 )
          case B_2_send_case_1
          by solve( !KU( ~x ) @ #vk.10 )
        next
          case B_2_send_case_2
          by solve( !KU( ~x ) @ #vk.10 )
        next
          case c_exp
          by solve( !KU( ~x ) @ #vk.10 )
        qed
      next
        case c_senc
        solve( !KU( h(~sharedKeyAB) ) @ #vk.6 )
          case c_h
          solve( !KU( ~sharedKeyAB ) @ #vk.7 )
            case Reveal_case_1
            by contradiction /* from formulas */
          next
            case Reveal_case_2
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case A_3_send_case_2
      solve( !KU( senc(s, h(~sharedKeyAB)) ) @ #vk.3 )
        case A_1_send_case_1
        solve( !KU( map(~s, $p)^~x ) @ #vk.3 )
          case A_1_send
