            case B_2_send_case_06
            by solve( !KU( ~y ) @ #vk.12 )
          next
            case B_2_send_case_07
            by solve( !KU( ~x ) @ #vk.10 )
          next
            case B_2_send_case_08
            by solve( !KU( ~y ) @ #vk.13 )
          next
            case B_2_send_case_09
            by solve( !KU( ~x ) @ #vk.10 )
