theory P5ab begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman
functions: fst/1, h/1, map/2, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2











rule (modulo E) ShareKey:
   [ Fr( ~sharedKeyAB ) ]
  --[ ShareKey( $A, $B, ~sharedKeyAB ) ]->
   [
   !SharedKey( $A, $B, ~sharedKeyAB ),
   !SharedKey( $B, $A, ~sharedKeyAB )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal:
   [ !SharedKey( $A, $B, ~sharedKeyAB ) ]
  --[ Reveal( $A ) ]->
   [ Out( ~sharedKeyAB ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Init_A:
   [ !SharedKey( $I, $R, ~sharedKeyAB ), Fr( ~id ) ]
  --[ Create_A( $I, ~id ) ]->
   [ St_A_1( $I, ~id, $R, ~sharedKeyAB ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Init_B:
   [ !SharedKey( $R, $I, ~sharedKeyAB ), Fr( ~id ) ]
  --[ Create_B( $R, ~id ) ]->
   [ St_B_1( $R, ~id, $I, ~sharedKeyAB ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) A_1_send:
   [ St_A_1( $I, ~id, $R, ~sharedKeyAB ), Fr( ~x ), Fr( ~s ) ]
  --[ Send( $I, map(~s, $p)^~x ) ]->
   [
   St_A_2( $I, ~id, $R, ~sharedKeyAB, ~s, $p, ~x ),
   Out( <map(~s, $p)^~x, senc(~s, h(~sharedKeyAB))> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_1_receive:
   [
   St_B_1( $R, ~id, $I, ~sharedKeyAB ),
   In( <X, senc(s, h(~sharedKeyAB))> )
   ]
  --[ Receive( $R, X ), NotNeutral( X ) ]->
   [ St_B_2( $R, ~id, $I, ~sharedKeyAB, s, $p, X ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_2_send:
   [ St_B_2( $R, ~id, $I, ~sharedKeyAB, s, $p, X ), Fr( ~y ) ]
  --[
  Send( $R, map(s, $p)^~y ),
  Running( $R, $I, <'I', 'R', X, map(s, $p)^~y, h(X^~y)> )
  ]->
   [
   St_B_3( $R, ~id, $I, ~sharedKeyAB, s, $p, X, ~y, h(X^~y) ),
   Out( map(s, $p)^~y )
   ]

  /*
  rule (modulo AC) B_2_send:
     [ St_B_2( $R, ~id, $I, ~sharedKeyAB, s, $p, X ), Fr( ~y ) ]
    --[
    Send( $R, map(s, $p)^~y ),
    Running( $R, $I, <'I', 'R', X, map(s, $p)^~y, h(z)> )
    ]->
     [
     St_B_3( $R, ~id, $I, ~sharedKeyAB, s, $p, X, ~y, h(z) ),
     Out( map(s, $p)^~y )
     ]
    variants (modulo AC)
    1. ~y    = ~y.20
       X     = X.21
       z     = X.21^~y.20
    
    2. ~y    = ~y.21
       X     = z.24^inv(~y.21)
       z     = z.24
    
    3. ~y    = ~y.128
       X     = x.248^x.249
       z     = x.248^(~y.128*x.249)
    
    4. ~y    = ~y.129
       X     = x.250^inv((~y.129*x.251))
       z     = x.250^inv(x.251)
    
    5. ~y    = ~y.129
       X     = x.250^(x.251*inv(~y.129))
       z     = x.250^x.251
    
    6. ~y    = ~y.130
       X     = x.251^(x.252*inv((~y.130*x.253)))
       z     = x.251^(x.252*inv(x.253))
    
    7. X     = DH_neutral
       z     = DH_neutral
  */

rule (modulo E) A_2_receive:
   [ St_A_2( $I, ~id, $R, ~sharedKeyAB, ~s, $p, ~x ), In( Y ) ]
  --[ Receive( $I, Y ), NotNeutral( Y ) ]->
   [ St_A_3( $I, ~id, $R, ~sharedKeyAB, ~s, $p, ~x, Y, h(Y^~x) ) ]

  /*
  rule (modulo AC) A_2_receive:
     [ St_A_2( $I, ~id, $R, ~sharedKeyAB, ~s, $p, ~x ), In( Y ) ]
    --[ Receive( $I, Y ), NotNeutral( Y ) ]->
     [ St_A_3( $I, ~id, $R, ~sharedKeyAB, ~s, $p, ~x, Y, h(z) ) ]
    variants (modulo AC)
    1. ~x    = ~x.10
       Y     = Y.10
       z     = Y.10^~x.10
    
    2. ~x    = ~x.10
       Y     = x.11^inv(~x.10)
       z     = x.11
    
    3. ~x    = ~x.10
       Y     = x.11^inv((~x.10*x.12))
       z     = x.11^inv(x.12)
    
    4. ~x    = ~x.10
       Y     = x.11^(x.12*inv(~x.10))
       z     = x.11^x.12
    
    5. ~x    = ~x.10
       Y     = x.11^(x.12*inv((~x.10*x.13)))
       z     = x.11^(x.12*inv(x.13))
    
    6. ~x    = ~x.12
       Y     = x.10^x.11
       z     = x.10^(x.11*~x.12)
    
    7. Y     = DH_neutral
       z     = DH_neutral
  */

rule (modulo E) A_3_send:
   [ St_A_3( $I, ~id, $R, ~sharedKeyAB, ~s, $p, ~x, Y, Kab ) ]
  --[
  Send( $I, Y ),
  Running( $I, $R, <'R', 'I', map(~s, $p)^~x, Y, Kab> )
  ]->
   [
   St_A_4( $I, ~id, $R, ~sharedKeyAB, ~s, $p, ~x, Y, Kab ),
   Out( senc(<'I', $I, Y>, Kab) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_3_receive:
   [
   St_B_3( $R, ~id, $I, ~sharedKeyAB, s, $p, X, ~y, Kab ),
   In( senc(<'I', $I, map(s, $p)^~y>, Kab) )
   ]
  --[
  Receive( $R, X ),
  Commit( $R, $I, <'R', 'I', X, map(s, $p)^~y, Kab> )
  ]->
   [ St_B_4( $R, ~id, $I, ~sharedKeyAB, s, $p, X, ~y, Kab ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_4_send:
   [ St_B_4( $R, ~id, $I, ~sharedKeyAB, s, $p, X, ~y, Kab ) ]
  --[
  Send( $R, X ), Secret( $R, $I, Kab ),
  FinishedB( $R, $I, <X, map(s, $p)^~y, Kab> )
  ]->
   [
   St_B_5( $R, ~id, $I, ~sharedKeyAB, s, $p, X, ~y, Kab ),
   Out( senc(<'R', $R, X>, Kab) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) A_4_receive:
   [
   St_A_4( $I, ~id, $R, ~sharedKeyAB, ~s, $p, ~x, Y, Kab ),
   In( senc(<'R', $R, map(~s, $p)^~x>, Kab) )
   ]
  --[
  Receive( $I, map(~s, $p)^~x ),
  Commit( $I, $R, <'I', 'R', map(~s, $p)^~x, Y, Kab> ),
  Secret( $I, $R, Kab ),
  FinishedA( $I, $R, <map(~s, $p)^~x, Y, Kab> )
  ]->
   [ St_A_5( $I, ~id, $R, ~sharedKeyAB, ~s, $p, ~x, Y, Kab ) ]

  /* has exactly the trivial AC variant */

lemma executable:
  exists-trace
  "∃ #i #j A B m.
    ((((FinishedA( A, B, m ) @ #i) ∧ (FinishedB( B, A, m ) @ #j)) ∧
      (¬(A = B))) ∧
     (¬(∃ #k. Reveal( A ) @ #k))) ∧
    (¬(∃ #k. Reveal( B ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j A B m.
  (FinishedA( A, B, m ) @ #i) ∧ (FinishedB( B, A, m ) @ #j)
 ∧
  (¬(A = B)) ∧
  (∀ #k. (Reveal( A ) @ #k) ⇒ ⊥) ∧
  (∀ #k. (Reveal( B ) @ #k) ⇒ ⊥)"
*/
simplify
solve( St_A_4( $I, ~id, $R, ~sharedKeyAB, ~s, $p, ~x,
               map(s.1, $p.1)^~y, Kab
       ) ▶₀ #i )
  case A_3_send_case_1
  solve( St_B_4( $R, ~id.1, $I, ~sharedKeyAB.1, s.1, $p.1,
                 map(~s, $p)^~x, ~y, h(map(s.1, $p.1)^(~x*~y))
         ) ▶₀ #j )
    case B_3_receive_case_2
    solve( !KU( senc(~s, h(~sharedKeyAB.1)) ) @ #vk.5 )
      case A_1_send
      solve( !KU( senc(<'R', $R, map(~s, $p)^~x>, h(map(~s, $p)^(~x*~y)))
             ) @ #vk.1 )
        case B_4_send
        solve( !KU( map(~s, $p)^~y ) @ #vk.3 )
          case B_2_send_case_1
          solve( !KU( senc(<'I', $I, map(~s, $p)^~y>, h(map(~s, $p)^(~x*~y)))
                 ) @ #vk.4 )
            case A_3_send
            solve( !KU( map(~s, $p)^~x ) @ #vk.5 )
              case A_1_send
              SOLVED // trace found
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma injectiveagreementINITIATOR:
  all-traces
  "∀ a b t #i.
    ((Commit( a, b, <'I', 'R', t> ) @ #i) ∧
     (¬((∃ #r. Reveal( a ) @ #r) ∨ (∃ #r. Reveal( b ) @ #r)))) ⇒
    (∃ #j.
      (Running( b, a, <'I', 'R', t> ) @ #j) ∧
      (¬(∃ a2 b2 #i2.
          (Commit( a2, b2, <'I', 'R', t> ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ a b t #i.
  (Commit( a, b, <'I', 'R', t> ) @ #i)
 ∧
  (∀ #r. (Reveal( a ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( b ) @ #r) ⇒ ⊥) ∧
  (∀ #j.
    (Running( b, a, <'I', 'R', t> ) @ #j)
   ⇒
    ∃ a2 b2 #i2.
     (Commit( a2, b2, <'I', 'R', t> ) @ #i2) ∧ ¬(#i2 = #i))"
*/
simplify
solve( Commit( a, b, <'I', 'R', t> ) @ #i )
  case A_4_receive
  solve( St_A_4( $I, ~id, $R, ~sharedKeyAB, ~s, $p, ~x, Y, Kab
         ) ▶₀ #i )
    case A_3_send_case_1
    solve( !KU( senc(<'R', $R, map(~s, $p)^~x>, h(z)) ) @ #vk )
      case B_4_send_case_1
      solve( !KU( senc(<'I', $I.1, map(s.1, $p.1)^~y>,
                       h(map(~s, $p)^(~x*~y)))
             ) @ #vk.2 )
        case A_3_send
        solve( (#i2 < #i)  ∥ (#i < #i2) )
          case case_1
          solve( Commit( a2, b2,
                         <'I', 'R', map(~s, $p)^~x, map(~s, $p)^~y, h(map(~s, $p)^(~x*~y))>
                 ) @ #i2 )
            case A_4_receive
            solve( St_A_4( $I.1, ~id.1, $R.1, ~sharedKeyAB.1, ~s, $p, ~x,
                           map(~s, $p)^~y, h(map(~s, $p)^(~x*~y))
                   ) ▶₀ #i2 )
              case A_3_send
              by contradiction /* cyclic */
            qed
          qed
        next
          case case_2
          solve( Commit( a2, b2,
                         <'I', 'R', map(~s, $p)^~x, map(~s, $p)^~y, h(map(~s, $p)^(~x*~y))>
                 ) @ #i2 )
            case A_4_receive
            solve( St_A_4( $I.1, ~id.1, $R.1, ~sharedKeyAB.1, ~s, $p, ~x,
                           map(~s, $p)^~y, h(map(~s, $p)^(~x*~y))
                   ) ▶₀ #i2 )
              case A_3_send
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case c_senc
        solve( !KU( h(map(~s, $p)^(~x*~y)) ) @ #vk.7 )
          case c_h
          solve( !KU( map(~s, $p)^(~x*~y) ) @ #vk.12 )
            case A_1_send_case_1
            by solve( !KU( ~y ) @ #vk.13 )
          next
            case A_1_send_case_2
            by solve( !KU( ~x ) @ #vk.16 )
          next
            case B_2_send_case_1
            by solve( !KU( ~x ) @ #vk.12 )
          next
            case B_2_send_case_2
            by solve( !KU( ~y.1 ) @ #vk.16 )
          next
            case B_2_send_case_3
            by solve( !KU( ~y.1 ) @ #vk.16 )
          next
            case c_exp
            by solve( !KU( ~x ) @ #vk.15 )
          qed
        qed
      qed
    next
      case B_4_send_case_2
      solve( !KU( senc(<'I', $I.1, map(s.1, $p.1)^~y>,
                       h(map(~s, $p)^(~x*~y)))
             ) @ #vk.2 )
        case A_3_send
        solve( (#i2 < #i)  ∥ (#i < #i2) )
          case case_1
          solve( Commit( a2, b2,
                         <'I', 'R', map(~s, $p)^~x, map(~s, $p)^~y, h(map(~s, $p)^(~x*~y))>
                 ) @ #i2 )
            case A_4_receive
            solve( St_A_4( $I.1, ~id.1, $R.1, ~sharedKeyAB.1, ~s, $p, ~x,
                           map(~s, $p)^~y, h(map(~s, $p)^(~x*~y))
                   ) ▶₀ #i2 )
              case A_3_send
              by contradiction /* cyclic */
            qed
          qed
        next
          case case_2
          solve( Commit( a2, b2,
                         <'I', 'R', map(~s, $p)^~x, map(~s, $p)^~y, h(map(~s, $p)^(~x*~y))>
                 ) @ #i2 )
            case A_4_receive
            solve( St_A_4( $I.1, ~id.1, $R.1, ~sharedKeyAB.1, ~s, $p, ~x,
                           map(~s, $p)^~y, h(map(~s, $p)^(~x*~y))
                   ) ▶₀ #i2 )
              case A_3_send
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case c_senc
        solve( !KU( h(map(~s, $p)^(~x*~y)) ) @ #vk.7 )
          case c_h
          solve( !KU( map(~s, $p)^(~x*~y) ) @ #vk.12 )
            case A_1_send_case_1
            by solve( !KU( ~y ) @ #vk.13 )
          next
            case A_1_send_case_2
            by solve( !KU( ~x ) @ #vk.16 )
          next
            case B_2_send_case_1
            by solve( !KU( ~x ) @ #vk.12 )
          next
            case B_2_send_case_2
            by solve( !KU( ~y.1 ) @ #vk.16 )
          next
            case B_2_send_case_3
            by solve( !KU( ~y.1 ) @ #vk.16 )
          next
            case c_exp
            by solve( !KU( ~x ) @ #vk.15 )
          qed
        qed
      qed
    next
      case c_senc
      solve( splitEqs(1) )
        case split_case_1
        solve( !KU( h(Y^~x) ) @ #vk.3 )
          case c_h
          solve( !KU( Y^~x ) @ #vk.8 )
            case A_1_send_case_1
            solve( !KU( map(~s, $p) ) @ #vk.3 )
              case A_1_send
              by solve( !KU( ~x ) @ #vk.9 )
            next
              case B_2_send_case_1
              by solve( !KU( ~y ) @ #vk.9 )
            next
              case B_2_send_case_2
              by solve( !KU( ~y ) @ #vk.9 )
            next
              case c_map
              solve( !KU( ~s ) @ #vk.8 )
                case A_1_send
                solve( !KU( ~sharedKeyAB ) @ #vk.11 )
                  case Reveal_case_1
                  by contradiction /* from formulas */
                next
                  case Reveal_case_2
                  by contradiction /* from formulas */
                qed
              qed
            qed
          next
            case A_1_send_case_2
            by solve( !KU( ~x ) @ #vk.10 )
          next
            case A_1_send_case_3
            by solve( !KU( ~x ) @ #vk.10 )
          next
            case B_2_send_case_1
            by solve( !KU( ~x ) @ #vk.10 )
          next
            case B_2_send_case_2
            by solve( !KU( ~x ) @ #vk.10 )
          next
            case c_exp
            by solve( !KU( ~x ) @ #vk.9 )
          qed
        qed
      next
        case split_case_2
        solve( !KU( z^inv(~x) ) @ #vk.1 )
          case A_1_send_case_1
          by solve( !KU( ~x.1 ) @ #vk.10 )
        next
          case A_1_send_case_2
          by solve( !KU( ~x.1 ) @ #vk.10 )
        next
          case A_1_send_case_3
          by solve( !KU( ~x.1 ) @ #vk.11 )
        next
          case A_1_send_case_4
          by solve( !KU( ~x.1 ) @ #vk.11 )
        next
          case B_2_send_case_1
          by solve( !KU( ~y ) @ #vk.10 )
        next
          case B_2_send_case_2
          by solve( !KU( ~y ) @ #vk.10 )
        next
          case B_2_send_case_3
          by solve( !KU( ~y ) @ #vk.11 )
        next
          case B_2_send_case_4
          by solve( !KU( ~y ) @ #vk.11 )
        next
          case c_exp
          by solve( !KU( ~x ) @ #vk.10 )
        qed
      next
        case split_case_3
        solve( !KU( h(x.1^(~x*x.2)) ) @ #vk.3 )
          case c_h
          solve( !KU( x.1^(~x*x.2) ) @ #vk.8 )
            case A_1_send_case_01
            by solve( !KU( ~x ) @ #vk.9 )
          next
            case A_1_send_case_02
            solve( !KU( map(~s, $p)^x.1 ) @ #vk.3 )
              case A_1_send_case_1
              by solve( !KU( ~x ) @ #vk.8 )
            next
              case A_1_send_case_2
              by solve( !KU( ~x ) @ #vk.11 )
            next
              case A_1_send_case_3
              by solve( !KU( ~x ) @ #vk.12 )
            next
              case A_1_send_case_4
              by solve( !KU( ~x ) @ #vk.12 )
            next
              case A_1_send_case_5
              by solve( !KU( ~x ) @ #vk.14 )
            next
              case B_2_send_case_01
              by solve( !KU( ~y ) @ #vk.9 )
            next
              case B_2_send_case_02
              by solve( !KU( ~y ) @ #vk.9 )
            next
              case B_2_send_case_03
              by solve( !KU( ~y ) @ #vk.14 )
            next
              case B_2_send_case_04
              by solve( !KU( ~y ) @ #vk.14 )
            next
              case B_2_send_case_05
              by solve( !KU( ~y ) @ #vk.12 )
            next
              case B_2_send_case_06
              by solve( !KU( ~y ) @ #vk.12 )
            next
              case B_2_send_case_07
              by solve( !KU( ~y ) @ #vk.12 )
            next
              case B_2_send_case_08
              by solve( !KU( ~y ) @ #vk.12 )
            next
              case B_2_send_case_09
              by solve( !KU( ~y ) @ #vk.14 )
            next
              case B_2_send_case_10
              by solve( !KU( ~y ) @ #vk.14 )
            next
              case c_exp
              solve( !KU( map(~s, $p) ) @ #vk.10 )
                case A_1_send
                by solve( !KU( ~x ) @ #vk.12 )
              next
                case B_2_send_case_1
                by solve( !KU( ~y ) @ #vk.12 )
              next
                case B_2_send_case_2
                by solve( !KU( ~y ) @ #vk.12 )
              next
                case c_map
                solve( !KU( ~s ) @ #vk.11 )
                  case A_1_send
                  solve( !KU( ~sharedKeyAB ) @ #vk.14 )
                    case Reveal_case_1
                    by contradiction /* from formulas */
                  next
                    case Reveal_case_2
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          next
            case A_1_send_case_03
            by solve( !KU( ~x ) @ #vk.10 )
          next
            case A_1_send_case_04
            by solve( !KU( ~x ) @ #vk.9 )
          next
            case A_1_send_case_05
            by solve( !KU( ~x ) @ #vk.10 )
          next
            case A_1_send_case_06
            by solve( !KU( ~x.2 ) @ #vk.12 )
          next
            case A_1_send_case_07
            by solve( !KU( ~x.2 ) @ #vk.12 )
          next
            case A_1_send_case_08
            by solve( !KU( ~x ) @ #vk.10 )
          next
            case A_1_send_case_09
            by solve( !KU( ~x.3 ) @ #vk.13 )
          next
            case A_1_send_case_10
            by solve( !KU( ~x ) @ #vk.10 )
          next
            case A_1_send_case_11
            by solve( !KU( ~x.3 ) @ #vk.13 )
          next
            case B_2_send_case_01
            by solve( !KU( ~x ) @ #vk.9 )
          next
            case B_2_send_case_02
            by solve( !KU( ~x ) @ #vk.13 )
          next
            case B_2_send_case_03
            by solve( !KU( ~x ) @ #vk.9 )
          next
            case B_2_send_case_04
            by solve( !KU( ~x ) @ #vk.13 )
          next
            case B_2_send_case_05
            by solve( !KU( ~y ) @ #vk.12 )
          next
            case B_2_send_case_06
            by solve( !KU( ~y ) @ #vk.12 )
          next
            case B_2_send_case_07
            by solve( !KU( ~x ) @ #vk.10 )
          next
            case B_2_send_case_08
            by solve( !KU( ~y ) @ #vk.13 )
          next
            case B_2_send_case_09
            by solve( !KU( ~x ) @ #vk.10 )
          next
