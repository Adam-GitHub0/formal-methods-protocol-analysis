      qed
    next
      case c_senc
      solve( !KU( senc(s, h(~sharedKeyAB)) ) @ #vk.3 )
        case A_1_send_case_1
        solve( splitEqs(1) )
          case split_case_1
          solve( !KU( h(X^~y) ) @ #vk.5 )
            case c_h
            solve( !KU( X^~y ) @ #vk.10 )
