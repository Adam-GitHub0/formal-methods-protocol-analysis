          by solve( !KU( ~x ) @ #vk.10 )
        qed
      next
        case split_case_3
        solve( !KU( h(x.1^(~x*x.2)) ) @ #vk.1 )
          case c_h
          solve( !KU( x.1^(~x*x.2) ) @ #vk.8 )
            case A_1_send_case_01
