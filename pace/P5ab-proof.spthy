               ) @ #vk.3 )
          case B_2_send_case_1
          by solve( !KU( ~x ) @ #vk.10 )
        next
          case B_2_send_case_2
          by solve( !KU( ~x ) @ #vk.10 )
        next
          case c_exp
          by solve( !KU( ~x ) @ #vk.10 )
        qed
      next
        case B_4_send_case_2
        solve( !KU( map(<'R', $R.1, ~sharedKeyAB^inv(~y)>, $p)^~x
               ) @ #vk.3 )
          case B_2_send_case_1
          by solve( !KU( ~x ) @ #vk.10 )
        next
          case B_2_send_case_2
          by solve( !KU( ~x ) @ #vk.10 )
        next
          case c_exp
          by solve( !KU( ~x ) @ #vk.10 )
