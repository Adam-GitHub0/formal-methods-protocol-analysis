restriction onedirectionnalsharedkey:
  "∀ A B k1 k2 #i #j.
    ((ShareKey( A, B, k1 ) @ #i) ∧ (ShareKey( A, B, k2 ) @ #j)) ⇒
    ((#i = #j) ∧ (k1 = k2))"
  // safety formula

restriction only1threadsA:
  "∀ A id1 id2 #i #j.
    ((Create_A( A, id1 ) @ #i) ∧ (Create_A( A, id2 ) @ #j)) ⇒
    ((#i = #j) ∧ (id1 = id2))"
  // safety formula

restriction onlyonerole:
  "∀ X id1 id2 #i #j.
    ((Create_A( X, id1 ) @ #i) ∧ (Create_B( X, id2 ) @ #j)) ⇒ (⊥)"
  // safety formula

restriction only1threadsB:
  "∀ B id1 id2 #i #j.
    ((Create_B( B, id1 ) @ #i) ∧ (Create_B( B, id2 ) @ #j)) ⇒
    ((#i = #j) ∧ (id1 = id2))"
  // safety formula











