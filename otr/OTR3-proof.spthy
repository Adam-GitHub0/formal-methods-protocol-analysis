theory OTR3 begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman
functions: fst/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true









rule (modulo E) Register_pk:
   [ Fr( ~ltk ) ]
  --[ Register( $P ) ]->
   [ !Ltk( $P, ~ltk ), !Pk( $P, pk(~ltk) ), Out( pk(~ltk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_ltk:
   [ !Ltk( $P, ~ltk ) ] --[ Reveal( $P ) ]-> [ Out( ~ltk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Init_A:
   [ !Ltk( $I, ~ltkI ), !Pk( $R, pkR ), Fr( ~id ) ]
  --[ Create_A( $I, ~id ) ]->
   [ St_A_1( $I, ~id, $R, ~ltkI, pkR ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Init_B:
   [ !Ltk( $R, ~ltkR ), !Pk( $I, pkI ), Fr( ~id ) ]
  --[ Create_B( $R, ~id ) ]->
   [ St_B_1( $R, ~id, $I, ~ltkR, pkI ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) A_1_send:
   [ St_A_1( $I, ~id, $R, ~ltkI, pkR ), Fr( ~x ) ]
  --[
  Send( $I, 'g'^~x ),
  Running( $I, $R,
           <'R', 'I', 'g'^~x, 'g'^~x, sign(<'g'^~x, $R>, ~ltkI), pk(~ltkI)>
  )
  ]->
   [
   St_A_2( $I, ~id, $R, ~ltkI, pkR, ~x,
           <'g'^~x, sign(<'g'^~x, $R>, ~ltkI), pk(~ltkI)>
   ),
   Out( <'g'^~x, sign(<'g'^~x, $R>, ~ltkI), pk(~ltkI)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_1_receive:
   [
   St_B_1( $R, ~id, $I, ~ltkR, pk(ltkI) ),
   In( <X, sign(<X, $R>, ltkI), pk(ltkI)> )
   ]
  --[
  Receive( $R, X ),
  Commit( $R, $I, <'R', 'I', X, X, sign(<X, $R>, ltkI), pk(ltkI)> )
  ]->
   [
   St_B_2( $R, ~id, $I, ~ltkR, pk(ltkI), X,
           <X, sign(<X, $R>, ltkI), pk(ltkI)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_2_send:
   [ St_B_2( $R, ~id, $I, ~ltkR, pkI, X, t1 ), Fr( ~y ) ]
  --[
  Send( $R, 'g'^~y ), KeyIdentityAssociation( $R, $I, X^~y ),
  FinishedB( $R, $I,
             <t1, <'g'^~y, sign(<'g'^~y, $I>, ~ltkR), pk(~ltkR)>, X^~y>
  ),
  Running( $R, $I,
           <'I', 'R', X, 'g'^~y, X^~y, t1, 'g'^~y, sign(<'g'^~y, $I>, ~ltkR), 
            pk(~ltkR)>
  )
  ]->
   [
   St_B_3( $R, ~id, $I, ~ltkR, pkI, X, ~y, t1,
           <'g'^~y, sign(<'g'^~y, $I>, ~ltkR), pk(~ltkR)>
   ),
   Out( <'g'^~y, sign(<'g'^~y, $I>, ~ltkR), pk(~ltkR)> )
   ]

  /*
  rule (modulo AC) B_2_send:
     [ St_B_2( $R, ~id, $I, ~ltkR, pkI, X, t1 ), Fr( ~y ) ]
    --[
    Send( $R, 'g'^~y ), KeyIdentityAssociation( $R, $I, z ),
    FinishedB( $R, $I,
               <t1, <'g'^~y, sign(<'g'^~y, $I>, ~ltkR), pk(~ltkR)>, z>
    ),
    Running( $R, $I,
             <'I', 'R', X, 'g'^~y, z, t1, 'g'^~y, sign(<'g'^~y, $I>, ~ltkR), 
              pk(~ltkR)>
    )
    ]->
     [
     St_B_3( $R, ~id, $I, ~ltkR, pkI, X, ~y, t1,
             <'g'^~y, sign(<'g'^~y, $I>, ~ltkR), pk(~ltkR)>
     ),
     Out( <'g'^~y, sign(<'g'^~y, $I>, ~ltkR), pk(~ltkR)> )
     ]
    variants (modulo AC)
    1. ~y    = ~y.13
       X     = X.14
       z     = X.14^~y.13
    
    2. ~y    = ~y.17
       X     = z.22^inv(~y.17)
       z     = z.22
    
    3. ~y    = ~y.64
       X     = x.121^x.122
       z     = x.121^(~y.64*x.122)
    
    4. ~y    = ~y.65
       X     = x.123^inv((~y.65*x.124))
       z     = x.123^inv(x.124)
    
    5. ~y    = ~y.65
       X     = x.123^(x.124*inv(~y.65))
       z     = x.123^x.124
    
    6. ~y    = ~y.66
       X     = x.124^(x.125*inv((~y.66*x.126)))
       z     = x.124^(x.125*inv(x.126))
    
    7. X     = DH_neutral
       z     = DH_neutral
  */

rule (modulo E) A_2_receive:
   [
   St_A_2( $I, ~id, $R, ~ltkI, pk(ltkR), ~x, t1 ),
   In( <Y, sign(<Y, $I>, ltkR), pk(ltkR)> )
   ]
  --[
  Receive( $I, Y ), KeyIdentityAssociation( $I, $R, Y^~x ),
  Commit( $I, $R,
          <'I', 'R', 'g'^~x, Y, Y^~x, t1, Y, sign(<Y, $I>, ltkR), pk(ltkR)>
  ),
  FinishedA( $I, $R, <t1, <Y, sign(<Y, $I>, ltkR), pk(ltkR)>, Y^~x> )
  ]->
   [
   St_A_3( $I, ~id, $R, ~ltkI, pk(ltkR), ~x, Y, t1,
           <Y, sign(<Y, $I>, ltkR), pk(ltkR)>
   )
   ]

  /*
  rule (modulo AC) A_2_receive:
     [
     St_A_2( $I, ~id, $R, ~ltkI, pk(ltkR), ~x, t1 ),
     In( <Y, sign(<Y, $I>, ltkR), pk(ltkR)> )
     ]
    --[
    Receive( $I, Y ), KeyIdentityAssociation( $I, $R, z ),
    Commit( $I, $R,
            <'I', 'R', 'g'^~x, Y, z, t1, Y, sign(<Y, $I>, ltkR), pk(ltkR)>
    ),
    FinishedA( $I, $R, <t1, <Y, sign(<Y, $I>, ltkR), pk(ltkR)>, z> )
    ]->
     [
     St_A_3( $I, ~id, $R, ~ltkI, pk(ltkR), ~x, Y, t1,
             <Y, sign(<Y, $I>, ltkR), pk(ltkR)>
     )
     ]
    variants (modulo AC)
    1. ~x    = ~x.12
       Y     = Y.13
       z     = Y.13^~x.12
    
    2. ~x    = ~x.15
       Y     = z.19^inv(~x.15)
       z     = z.19
    
    3. ~x    = ~x.63
       Y     = x.119^x.120
       z     = x.119^(~x.63*x.120)
    
    4. ~x    = ~x.64
       Y     = x.121^inv((~x.64*x.122))
       z     = x.121^inv(x.122)
    
    5. ~x    = ~x.64
       Y     = x.121^(x.122*inv(~x.64))
       z     = x.121^x.122
    
    6. ~x    = ~x.65
       Y     = x.122^(x.123*inv((~x.65*x.124)))
       z     = x.122^(x.123*inv(x.124))
    
    7. Y     = DH_neutral
       z     = DH_neutral
  */

lemma executable:
  exists-trace
  "∃ #i #j A B m.
    ((((FinishedA( A, B, m ) @ #i) ∧ (FinishedB( B, A, m ) @ #j)) ∧
      (¬(A = B))) ∧
     (¬(∃ #k. Reveal( A ) @ #k))) ∧
    (¬(∃ #k. Reveal( B ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j A B m.
  (FinishedA( A, B, m ) @ #i) ∧ (FinishedB( B, A, m ) @ #j)
 ∧
  (¬(A = B)) ∧
  (∀ #k. (Reveal( A ) @ #k) ⇒ ⊥) ∧
  (∀ #k. (Reveal( B ) @ #k) ⇒ ⊥)"
*/
simplify
solve( St_A_2( $I, ~id, $R, ~ltkI, pk(~ltkR), ~x, t1 ) ▶₀ #i )
  case A_1_send
  solve( St_B_2( $R, ~id.1, $I, ~ltkR, pkI, 'g'^~x,
                 <'g'^~x, sign(<'g'^~x, $R>, ~ltkI), pk(~ltkI)>
         ) ▶₀ #j )
    case B_1_receive
    solve( !KU( sign(<'g'^~y, $I>, ~ltkR) ) @ #vk.3 )
      case B_2_send
      solve( !KU( sign(<'g'^~x, $R>, ~ltkI) ) @ #vk.8 )
        case A_1_send
        solve( !KU( pk(~ltkR) ) @ #vk.5 )
          case A_1_send
          solve( !KU( 'g'^~y ) @ #vk.7 )
            case B_2_send
            solve( !KU( 'g'^~x ) @ #vk.8 )
              case A_1_send
              solve( !KU( pk(~ltkI) ) @ #vk.9 )
                case A_1_send
                SOLVED // trace found
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma injectiveagreementINITIATOR:
  all-traces
  "∀ a b t #i.
    ((Commit( a, b, <'I', 'R', t> ) @ #i) ∧
     (¬((∃ #r. Reveal( a ) @ #r) ∨ (∃ #r. Reveal( b ) @ #r)))) ⇒
    (∃ #j.
      (Running( b, a, <'I', 'R', t> ) @ #j) ∧
      (¬(∃ a2 b2 #i2.
          (Commit( a2, b2, <'I', 'R', t> ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ a b t #i.
  (Commit( a, b, <'I', 'R', t> ) @ #i)
 ∧
  (∀ #r. (Reveal( a ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( b ) @ #r) ⇒ ⊥) ∧
  (∀ #j.
    (Running( b, a, <'I', 'R', t> ) @ #j)
   ⇒
    ∃ a2 b2 #i2.
     (Commit( a2, b2, <'I', 'R', t> ) @ #i2) ∧ ¬(#i2 = #i))"
*/
simplify
solve( Commit( a, b, <'I', 'R', t> ) @ #i )
  case A_2_receive
  solve( St_A_2( $I, ~id, $R, ~ltkI, pk(ltkR), ~x, t1 ) ▶₀ #i )
    case A_1_send
    solve( !KU( sign(<Y, $I>, ~ltk) ) @ #vk.3 )
      case A_1_send
      solve( !KU( pk(~ltk) ) @ #vk.4 )
        case A_1_send
        solve( !KU( 'g'^~x.1 ) @ #vk.4 )
          case A_1_send
          SOLVED // trace found
        qed
      qed
    qed
  qed
qed

lemma injectiveagreementRESPONDER:
  all-traces
  "∀ a b t #i.
    ((Commit( a, b, <'R', 'I', t> ) @ #i) ∧
     (¬((∃ #r. Reveal( a ) @ #r) ∨ (∃ #r. Reveal( b ) @ #r)))) ⇒
    (∃ #j.
      (Running( b, a, <'R', 'I', t> ) @ #j) ∧
      (¬(∃ a2 b2 #i2.
          (Commit( a2, b2, <'R', 'I', t> ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ a b t #i.
  (Commit( a, b, <'R', 'I', t> ) @ #i)
 ∧
  (∀ #r. (Reveal( a ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( b ) @ #r) ⇒ ⊥) ∧
  (∀ #j.
    (Running( b, a, <'R', 'I', t> ) @ #j)
   ⇒
    ∃ a2 b2 #i2.
     (Commit( a2, b2, <'R', 'I', t> ) @ #i2) ∧ ¬(#i2 = #i))"
*/
simplify
solve( Commit( a, b, <'R', 'I', t> ) @ #i )
  case B_1_receive
  solve( St_B_1( $R, ~id, $I, ~ltkR, pk(ltkI) ) ▶₀ #i )
    case Init_B
    solve( !KU( sign(<X, $R>, ~ltk) ) @ #vk.3 )
      case A_1_send
      solve( (#i2 < #i)  ∥ (#i < #i2) )
        case case_1
        solve( Commit( a2, b2,
                       <'R', 'I', 'g'^~x, 'g'^~x, sign(<'g'^~x, $R>, ~ltk), pk(~ltk)>
               ) @ #i2 )
          case B_1_receive
          solve( St_B_1( $R, ~id.1, $I.1, ~ltkR.1, pk(~ltk) ) ▶₀ #i2 )
            case Init_B
            solve( !KU( pk(~ltk) ) @ #vk.4 )
              case A_1_send
              solve( !KU( 'g'^~x ) @ #vk.4 )
                case A_1_send
                SOLVED // trace found
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma noninjectiveagreementINITIATOR:
  all-traces
  "∀ a b t #i.
    ((Commit( a, b, <'I', 'R', t> ) @ #i) ∧
     (¬((∃ #r. Reveal( a ) @ #r) ∨ (∃ #r. Reveal( b ) @ #r)))) ⇒
    (∃ #j. Running( b, a, <'I', 'R', t> ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ a b t #i.
  (Commit( a, b, <'I', 'R', t> ) @ #i)
 ∧
  (∀ #r. (Reveal( a ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( b ) @ #r) ⇒ ⊥) ∧
  (∀ #j. (Running( b, a, <'I', 'R', t> ) @ #j) ⇒ ⊥)"
*/
simplify
solve( Commit( a, b, <'I', 'R', t> ) @ #i )
  case A_2_receive
  solve( St_A_2( $I, ~id, $R, ~ltkI, pk(ltkR), ~x, t1 ) ▶₀ #i )
    case A_1_send
    solve( !KU( sign(<Y, $I>, ~ltk) ) @ #vk.3 )
      case A_1_send
      solve( !KU( pk(~ltk) ) @ #vk.4 )
        case A_1_send
        solve( !KU( 'g'^~x.1 ) @ #vk.4 )
          case A_1_send
          SOLVED // trace found
        qed
      qed
    qed
  qed
qed

