theory OTR4 begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman
functions: fst/1, h/1, mac/2, pair/2, pk/1, sign/2, snd/1, true/0,
           verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true











rule (modulo E) Register_pk:
   [ Fr( ~ltk ) ]
  --[ Register( $P ) ]->
   [ !Ltk( $P, ~ltk ), !Pk( $P, pk(~ltk) ), Out( pk(~ltk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_ltk:
   [ !Ltk( $P, ~ltk ) ] --[ Reveal( $P ) ]-> [ Out( ~ltk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Init_A:
   [ !Ltk( $I, ~ltkI ), !Pk( $R, pkR ), Fr( ~id ) ]
  --[ Create_A( $I, ~id ) ]->
   [ St_A_1( $I, ~id, $R, ~ltkI, pkR ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Init_B:
   [ !Ltk( $R, ~ltkR ), !Pk( $I, pkI ), Fr( ~id ) ]
  --[ Create_B( $R, ~id ) ]->
   [ St_B_1( $R, ~id, $I, ~ltkR, pkI ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) A_1_send:
   [ St_A_1( $I, ~id, $R, ~ltkI, pkR ), Fr( ~x ) ]
  --[ Send( $I, 'g'^~x ) ]->
   [ St_A_2( $I, ~id, $R, ~ltkI, pkR, ~x, 'g'^~x ), Out( 'g'^~x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_1_receive:
   [ St_B_1( $R, ~id, $I, ~ltkR, pkI ), In( 'g'^x ) ]
  --[ Receive( $R, 'g'^x ) ]->
   [ St_B_2( $R, ~id, $I, ~ltkR, pkI, 'g'^x ) ]

  /*
  rule (modulo AC) B_1_receive:
     [ St_B_1( $R, ~id, $I, ~ltkR, pkI ), In( z ) ]
    --[ Receive( $R, z ) ]->
     [ St_B_2( $R, ~id, $I, ~ltkR, pkI, z ) ]
    variants (modulo AC)
    1. z     = 'g'
    
    2. z     = 'g'^x.8
  */

rule (modulo E) B_2_send:
   [ St_B_2( $R, ~id, $I, ~ltkR, pkI, X ), Fr( ~y ) ]
  --[ Send( $R, 'g'^~y ) ]->
   [
   St_B_3( $R, ~id, $I, ~ltkR, pkI, X, ~y, 'g'^~y, X^~y ),
   Out( 'g'^~y )
   ]

  /*
  rule (modulo AC) B_2_send:
     [ St_B_2( $R, ~id, $I, ~ltkR, pkI, X ), Fr( ~y ) ]
    --[ Send( $R, 'g'^~y ) ]->
     [
     St_B_3( $R, ~id, $I, ~ltkR, pkI, X, ~y, 'g'^~y, z ), Out( 'g'^~y )
     ]
    variants (modulo AC)
    1. ~y    = ~y.15
       X     = X.16
       z     = X.16^~y.15
    
    2. ~y    = ~y.18
       X     = z.22^inv(~y.18)
       z     = z.22
    
    3. ~y    = ~y.37
       X     = x.67^x.68
       z     = x.67^(~y.37*x.68)
    
    4. ~y    = ~y.38
       X     = x.69^inv((~y.38*x.70))
       z     = x.69^inv(x.70)
    
    5. ~y    = ~y.38
       X     = x.69^(x.70*inv(~y.38))
       z     = x.69^x.70
    
    6. ~y    = ~y.39
       X     = x.70^(x.71*inv((~y.39*x.72)))
       z     = x.70^(x.71*inv(x.72))
    
    7. X     = DH_neutral
       z     = DH_neutral
  */

rule (modulo E) A_2_receive:
   [ St_A_2( $I, ~id, $R, ~ltkI, pkR, ~x, X ), In( 'g'^y ) ]
  --[ Receive( $I, 'g'^y ) ]->
   [ St_A_3( $I, ~id, $R, ~ltkI, pkR, ~x, X, 'g'^y, 'g'^y^~x ) ]

  /*
  rule (modulo AC) A_2_receive:
     [ St_A_2( $I, ~id, $R, ~ltkI, pkR, ~x, X ), In( z ) ]
    --[ Receive( $I, z ) ]->
     [ St_A_3( $I, ~id, $R, ~ltkI, pkR, ~x, X, z, z.1 ) ]
    variants (modulo AC)
    1. ~x    = ~x.11
       z     = 'g'
       z.1   = 'g'^~x.11
    
    2. ~x    = ~x.11
       z     = 'g'^y.11
       z.1   = 'g'^(~x.11*y.11)
    
    3. ~x    = ~x.11
       z     = 'g'^inv(~x.11)
       z.1   = 'g'
    
    4. ~x    = ~x.11
       z     = 'g'^inv((~x.11*x.14))
       z.1   = 'g'^inv(x.14)
    
    5. ~x    = ~x.11
       z     = 'g'^(x.14*inv(~x.11))
       z.1   = 'g'^x.14
    
    6. ~x    = ~x.11
       z     = 'g'^(x.14*inv((~x.11*x.15)))
       z.1   = 'g'^(x.14*inv(x.15))
  */

rule (modulo E) A_3_send:
   [ St_A_3( $I, ~id, $R, ~ltkI, pkR, ~x, X, Y, Gxy ) ]
  --[
  Send( $I,
        <$I, sign(<Y, X>, ~ltkI), mac(h(Gxy), <'0', $I>), pk(~ltkI)>
  ),
  Running( $I, $R,
           <'R', 'I', X, Y, Gxy, $I, sign(<Y, X>, ~ltkI), 
            mac(h(Gxy), <'0', $I>), pk(~ltkI)>
  )
  ]->
   [
   St_A_4( $I, ~id, $R, ~ltkI, pkR, ~x, X, Y, Gxy, h(Gxy),
           <$I, sign(<Y, X>, ~ltkI), mac(h(Gxy), <'0', $I>), pk(~ltkI)>
   ),
   Out( <$I, sign(<Y, X>, ~ltkI), mac(h(Gxy), <'0', $I>), pk(~ltkI)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_3_receive:
   [
   St_B_3( $R, ~id, $I, ~ltkR, pk(ltkI), X, ~y, Y, Gxy ),
   In( <$I, sign(<Y, X>, ltkI), mac(h(Gxy), <'0', $I>), pk(ltkI)> )
   ]
  --[
  Commit( $R, $I,
          <'R', 'I', X, Y, Gxy, $I, sign(<Y, X>, ltkI), 
           mac(h(Gxy), <'0', $I>), pk(ltkI)>
  )
  ]->
   [
   St_B_4( $R, ~id, $I, ~ltkR, pk(ltkI), X, ~y, Y, Gxy, h(Gxy),
           <$I, sign(<Y, X>, ltkI), mac(h(Gxy), <'0', $I>), pk(ltkI)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_4_send:
   [ St_B_4( $R, ~id, $I, ~ltkR, pkI, X, ~y, Y, Gxy, hashedGxy, t1 ) ]
  --[
  Send( $R,
        <$R, sign(<X, Y>, ~ltkR), mac(hashedGxy, <'1', $R>), pk(~ltkR)>
  ),
  Running( $R, $I,
           <'I', 'R', X, Y, Gxy, t1, $R, sign(<X, Y>, ~ltkR), 
            mac(hashedGxy, <'1', $R>), pk(~ltkR)>
  ),
  Secret( $R, $I, Gxy ),
  FinishedB( $R, $I,
             <X, Y, t1, $R, sign(<X, Y>, ~ltkR), mac(hashedGxy, <'1', $R>), 
              pk(~ltkR)>
  )
  ]->
   [
   St_B_5( $R, ~id, $I, ~ltkR, pkI, X, ~y, Gxy, hashedGxy, t1,
           <$R, sign(<X, Y>, ~ltkR), mac(hashedGxy, <'1', $R>), pk(~ltkR)>
   ),
   Out( <$R, sign(<X, Y>, ~ltkR), mac(hashedGxy, <'1', $R>), pk(~ltkR)
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) A_4_receive:
   [
   St_A_4( $I, ~id, $R, ~ltkI, pk(ltkR), ~x, X, Y, Gxy, hashedGxy, t1
   ),
   In( <$R, sign(<X, Y>, ltkR), mac(hashedGxy, <'1', $R>), pk(ltkR)> )
   ]
  --[
  Receive( $I, Y ),
  Commit( $I, $R,
          <'I', 'R', X, Y, Gxy, t1, $R, sign(<X, Y>, ltkR), 
           mac(hashedGxy, <'1', $R>), pk(ltkR)>
  ),
  Secret( $I, $R, Gxy ),
  FinishedA( $I, $R,
             <X, Y, t1, $R, sign(<X, Y>, ltkR), mac(hashedGxy, <'1', $R>), 
              pk(ltkR)>
  )
  ]->
   [
   St_A_5( $I, ~id, $R, ~ltkI, pk(ltkR), ~x, X, Y, Gxy, hashedGxy, t1,
           <$R, sign(<X, Y>, ltkR), mac(hashedGxy, <'1', $R>), pk(ltkR)>
   )
   ]

  /* has exactly the trivial AC variant */

lemma executable:
  exists-trace
  "∃ #i #j A B m.
    ((((FinishedA( A, B, m ) @ #i) ∧ (FinishedB( B, A, m ) @ #j)) ∧
      (¬(A = B))) ∧
     (¬(∃ #k. Reveal( A ) @ #k))) ∧
    (¬(∃ #k. Reveal( B ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i #j A B m.
  (FinishedA( A, B, m ) @ #i) ∧ (FinishedB( B, A, m ) @ #j)
 ∧
  (¬(A = B)) ∧
  (∀ #k. (Reveal( A ) @ #k) ⇒ ⊥) ∧
  (∀ #k. (Reveal( B ) @ #k) ⇒ ⊥)"
*/
simplify
solve( St_A_4( $I, ~id, $R, ~ltkI, pk(~ltkR), ~x, X, Y, Gxy,
               hashedGxy, t1
       ) ▶₀ #i )
  case A_3_send
  solve( St_B_4( $R, ~id.1, $I, ~ltkR, pkI, 'g'^~x, ~y, Y, Gxy.1,
                 h(Gxy),
                 <$I, sign(<Y, 'g'^~x>, ~ltkI), mac(h(Gxy), <'0', $I>), pk(~ltkI)>
         ) ▶₀ #j )
    case B_3_receive
    solve( !KU( sign(<'g'^~x, 'g'^~y>, ~ltkR) ) @ #vk.3 )
      case B_4_send
      solve( !KU( sign(<'g'^~y, 'g'^~x>, ~ltkI) ) @ #vk.11 )
        case A_3_send
        solve( !KU( mac(h('g'^(~x*~y)), <'1', $R>) ) @ #vk.6 )
          case B_4_send
          solve( splitEqs(3) )
            case split_case_1
            solve( !KU( pk(~ltkR) ) @ #vk.9 )
              case A_3_send
              solve( splitEqs(5) )
                case split_case_2
                solve( !KU( mac(h('g'^(~x*~y)), <'0', $I>) ) @ #vk.13 )
                  case A_3_send
                  solve( splitEqs(7) )
                    case split_case_1
                    solve( !KU( pk(~ltk) ) @ #vk.14 )
                      case A_3_send
                      solve( splitEqs(9) )
                        case split_case_2
                        solve( !KU( 'g'^~x ) @ #vk.15 )
                          case A_1_send
                          solve( !KU( 'g'^~y ) @ #vk.14 )
                            case B_2_send
                            SOLVED // trace found
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma injectiveagreementINITIATOR:
  all-traces
  "∀ a b t #i.
    ((Commit( a, b, <'I', 'R', t> ) @ #i) ∧
     (¬((∃ #r. Reveal( a ) @ #r) ∨ (∃ #r. Reveal( b ) @ #r)))) ⇒
    (∃ #j.
      (Running( b, a, <'I', 'R', t> ) @ #j) ∧
      (¬(∃ a2 b2 #i2.
          (Commit( a2, b2, <'I', 'R', t> ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ a b t #i.
  (Commit( a, b, <'I', 'R', t> ) @ #i)
 ∧
  (∀ #r. (Reveal( a ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( b ) @ #r) ⇒ ⊥) ∧
  (∀ #j.
    (Running( b, a, <'I', 'R', t> ) @ #j)
   ⇒
    ∃ a2 b2 #i2.
     (Commit( a2, b2, <'I', 'R', t> ) @ #i2) ∧ ¬(#i2 = #i))"
*/
simplify
solve( Commit( a, b, <'I', 'R', t> ) @ #i )
  case A_4_receive
  solve( St_A_4( $I, ~id, $R, ~ltkI, pk(ltkR), ~x, X, Y, Gxy,
                 hashedGxy, t1
         ) ▶₀ #i )
    case A_3_send
    solve( !KU( sign(<'g'^~x, Y>, ~ltk) ) @ #vk.3 )
      case A_3_send
      solve( !KU( mac(h('g'^(~x*~x.1)), <'1', $R>) ) @ #vk.5 )
        case B_4_send
        solve( splitEqs(2) )
          case split
          solve( !KU( sign(<'g'^~y, 'g'^(~x*~x.1*inv(~y))>, ~ltk.2)
                 ) @ #vk.12 )
            case c_sign
            solve( !KU( ~ltk.2 ) @ #vk.18 )
              case Reveal_ltk
              solve( !KU( 'g'^(~x*~x.1*inv(~y)) ) @ #vk.17 )
                case A_1_send_case_1
                by solve( !KU( ~x ) @ #vk.21 )
              next
                case A_1_send_case_2
                by solve( !KU( ~x.1 ) @ #vk.21 )
              next
                case c_exp
                by solve( !KU( ~x ) @ #vk.22 )
              qed
            qed
          qed
        qed
      next
        case c_mac
        solve( !KU( h('g'^(~x*~x.1)) ) @ #vk.10 )
          case c_h
          solve( !KU( 'g'^(~x*~x.1) ) @ #vk.12 )
            case A_1_send_case_1
            by solve( !KU( ~x ) @ #vk.13 )
          next
            case A_1_send_case_2
            by solve( !KU( ~x.1 ) @ #vk.13 )
          next
            case c_exp
            by solve( !KU( ~x ) @ #vk.15 )
          qed
        qed
      qed
    next
      case B_4_send
      solve( !KU( sign(<'g'^~y, 'g'^~x>, ~ltk.1) ) @ #vk.11 )
        case A_3_send
        solve( (#i2 < #i)  ∥ (#i < #i2) )
          case case_1
          solve( Commit( a2, b2,
                         <'I', 'R', 'g'^~x, 'g'^~y, 'g'^(~x*~y), 
                          <$I, sign(<'g'^~y, 'g'^~x>, ~ltkI), 
                           mac(h('g'^(~x*~y)), <'0', $I>), pk(~ltkI)>, 
                          $R, sign(<'g'^~x, 'g'^~y>, ~ltk), mac(h('g'^(~x*~y)), <'1', $R>), 
                          pk(~ltk)>
                 ) @ #i2 )
            case A_4_receive
            solve( St_A_4( $I.1, ~id.1, $R, ~ltkI.1, pk(~ltk), ~x.1, 'g'^~x,
                           'g'^~y, 'g'^(~x*~y), h('g'^(~x*~y)),
                           <$I, sign(<'g'^~y, 'g'^~x>, ~ltkI), 
                            mac(h('g'^(~x*~y)), <'0', $I>), pk(~ltkI)>
                   ) ▶₀ #i2 )
              case A_3_send
              by contradiction /* cyclic */
            qed
          qed
        next
          case case_2
          solve( Commit( a2, b2,
                         <'I', 'R', 'g'^~x, 'g'^~y, 'g'^(~x*~y), 
                          <$I, sign(<'g'^~y, 'g'^~x>, ~ltkI), 
                           mac(h('g'^(~x*~y)), <'0', $I>), pk(~ltkI)>, 
                          $R, sign(<'g'^~x, 'g'^~y>, ~ltk), mac(h('g'^(~x*~y)), <'1', $R>), 
                          pk(~ltk)>
                 ) @ #i2 )
            case A_4_receive
            solve( St_A_4( $I.1, ~id.1, $R, ~ltkI.1, pk(~ltk), ~x.1, 'g'^~x,
                           'g'^~y, 'g'^(~x*~y), h('g'^(~x*~y)),
                           <$I, sign(<'g'^~y, 'g'^~x>, ~ltkI), 
                            mac(h('g'^(~x*~y)), <'0', $I>), pk(~ltkI)>
                   ) ▶₀ #i2 )
              case A_3_send
              by contradiction /* cyclic */
            qed
          qed
        qed
      next
        case c_sign
        solve( !KU( ~ltk.1 ) @ #vk.17 )
          case Reveal_ltk
          solve( !KU( mac(h('g'^(~x*~y)), <'0', $I.1>) ) @ #vk.15 )
            case A_3_send
            solve( splitEqs(2) )
              case split_case_1
              by contradiction /* from formulas */
            next
              case split_case_2
              solve( !KU( 'g'^(~x*~y*inv(~x.1)) ) @ #vk.18 )
                case A_1_send
                by solve( !KU( ~y ) @ #vk.20 )
              next
                case B_2_send
                by solve( !KU( ~x ) @ #vk.20 )
              next
                case c_exp
                by solve( !KU( ~x ) @ #vk.21 )
              qed
            qed
          next
            case c_mac
            solve( !KU( h('g'^(~x*~y)) ) @ #vk.19 )
              case c_h
              solve( !KU( 'g'^(~x*~y) ) @ #vk.21 )
                case A_1_send
                by solve( !KU( ~y ) @ #vk.22 )
              next
                case B_2_send
                by solve( !KU( ~x ) @ #vk.22 )
              next
                case c_exp
                by solve( !KU( ~x ) @ #vk.24 )
              qed
            qed
          qed
        qed
      qed
    next
      case c_sign
      solve( !KU( ~ltk ) @ #vk.9 )
        case Reveal_ltk
        by contradiction /* from formulas */
      qed
    qed
  qed
qed

lemma injectiveagreementRESPONDER:
  all-traces
  "∀ a b t #i.
    ((Commit( a, b, <'R', 'I', t> ) @ #i) ∧
     (¬((∃ #r. Reveal( a ) @ #r) ∨ (∃ #r. Reveal( b ) @ #r)))) ⇒
    (∃ #j.
      (Running( b, a, <'R', 'I', t> ) @ #j) ∧
      (¬(∃ a2 b2 #i2.
          (Commit( a2, b2, <'R', 'I', t> ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ a b t #i.
  (Commit( a, b, <'R', 'I', t> ) @ #i)
 ∧
  (∀ #r. (Reveal( a ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( b ) @ #r) ⇒ ⊥) ∧
  (∀ #j.
    (Running( b, a, <'R', 'I', t> ) @ #j)
   ⇒
    ∃ a2 b2 #i2.
     (Commit( a2, b2, <'R', 'I', t> ) @ #i2) ∧ ¬(#i2 = #i))"
*/
simplify
solve( Commit( a, b, <'R', 'I', t> ) @ #i )
  case B_3_receive
  solve( St_B_3( $R, ~id, $I, ~ltkR, pk(ltkI), X, ~y, Y, Gxy
         ) ▶₀ #i )
    case B_2_send
    solve( splitEqs(1) )
      case split_case_2
      solve( !KU( sign(<'g'^~y, 'g'^x>, ~ltk) ) @ #vk.3 )
        case A_3_send
        solve( !KU( mac(h('g'^(~x*~y)), <'0', $I>) ) @ #vk.5 )
          case A_3_send
          solve( splitEqs(4) )
            case split_case_1
            solve( !KU( pk(~ltk) ) @ #vk.6 )
              case A_3_send
              solve( splitEqs(6) )
                case split_case_2
                solve( !KU( 'g'^~x ) @ #vk.7 )
                  case A_1_send
                  solve( !KU( 'g'^~y ) @ #vk.8 )
                    case B_2_send
                    SOLVED // trace found
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma noninjectiveagreementINITIATOR:
  all-traces
  "∀ a b t #i.
    ((Commit( a, b, <'I', 'R', t> ) @ #i) ∧
     (¬((∃ #r. Reveal( a ) @ #r) ∨ (∃ #r. Reveal( b ) @ #r)))) ⇒
    (∃ #j. Running( b, a, <'I', 'R', t> ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ a b t #i.
  (Commit( a, b, <'I', 'R', t> ) @ #i)
 ∧
  (∀ #r. (Reveal( a ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (Reveal( b ) @ #r) ⇒ ⊥) ∧
  (∀ #j. (Running( b, a, <'I', 'R', t> ) @ #j) ⇒ ⊥)"
*/
simplify
solve( Commit( a, b, <'I', 'R', t> ) @ #i )
  case A_4_receive
  solve( St_A_4( $I, ~id, $R, ~ltkI, pk(ltkR), ~x, X, Y, Gxy,
                 hashedGxy, t1
         ) ▶₀ #i )
    case A_3_send
    solve( !KU( sign(<'g'^~x, Y>, ~ltk) ) @ #vk.3 )
      case A_3_send
      solve( !KU( mac(h('g'^(~x*~x.1)), <'1', $R>) ) @ #vk.5 )
        case B_4_send
        solve( splitEqs(2) )
          case split
          solve( !KU( sign(<'g'^~y, 'g'^(~x*~x.1*inv(~y))>, ~ltk.2)
                 ) @ #vk.12 )
            case c_sign
            solve( !KU( ~ltk.2 ) @ #vk.18 )
              case Reveal_ltk
              solve( !KU( 'g'^(~x*~x.1*inv(~y)) ) @ #vk.17 )
                case A_1_send_case_1
                by solve( !KU( ~x ) @ #vk.21 )
              next
